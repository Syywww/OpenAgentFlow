# OpenAgentFlow-Java example environment.
# Copy this file to .env before using docker compose for local development.
# Production deployment should use .env.prod.example instead.

# MySQL
OAF_MYSQL_DATABASE=openagentflow
OAF_MYSQL_USERNAME=root
OAF_MYSQL_PASSWORD=123456
OAF_MYSQL_ROOT_PASSWORD=123456
OAF_MYSQL_URL=jdbc:mysql://mysql:3306/openagentflow?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai

# Redis
OAF_REDIS_HOST=redis
OAF_REDIS_PORT=6379
OAF_REDIS_DATABASE=0
OAF_REDIS_PASSWORD=

# Kafka distributed task queue
# 该文件用于 Docker Compose，容器通过宿主机地址连接独立 Kafka。
OAF_KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092
OAF_KAFKA_CONSUMER_GROUP=openagentflow-async-workers
OAF_KAFKA_CONCURRENCY=4
OAF_KAFKA_TASK_ENABLED=true
OAF_KAFKA_TASK_TOPIC=openagentflow.async-task
OAF_KAFKA_RETRY_TOPIC_5S=openagentflow.async-task.retry-5s
OAF_KAFKA_RETRY_TOPIC_30S=openagentflow.async-task.retry-30s
OAF_KAFKA_DLT_TOPIC=openagentflow.async-task.dlt
OAF_KAFKA_TASK_PARTITIONS=6
OAF_KAFKA_TASK_MAX_RETRIES=3
OAF_KAFKA_TASK_STALE_SECONDS=300

# MinIO shared document storage
OAF_MINIO_ENDPOINT=http://localhost:9000
OAF_MINIO_ACCESS_KEY=minioadmin
OAF_MINIO_SECRET_KEY=minioadmin
OAF_MINIO_BUCKET=openagentflow
OAF_OBJECT_STORAGE_ENABLED=true

# Milvus
OAF_MILVUS_HOST=milvus
OAF_MILVUS_PORT=19530
OAF_MILVUS_DATABASE=default
OAF_MILVUS_USERNAME=
OAF_MILVUS_PASSWORD=

# Backend security
OAF_AUTH_ENABLED=true
OAF_JWT_SECRET=please-change-this-secret-before-production
OAF_JWT_EXPIRE_MINUTES=1440
OAF_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api

# Ports
OAF_BACKEND_PORT=8080
OAF_FRONTEND_PORT=5173
OAF_MYSQL_PORT=3306
OAF_REDIS_PORT_PUBLIC=6379
OAF_MILVUS_PORT_PUBLIC=19530
OAF_MILVUS_METRICS_PORT=9091
OAF_MINIO_PORT=9000
OAF_MINIO_CONSOLE_PORT=9001
